    },
    {
        "id": 12,
        "word": "நட்பு",
        "text": "உண்மையான நட்பு துன்ப காலங்களில் துணையாக நிற்கும்",
        "source": "சமகால தமிழ்",
        "category": "உறவு"
    },
    {
        "id": 13,
        "word": "வாழ்க்கை",
        "text": "வாழ்க்கையில் வெற்றி பெற முயற்சியும் பொறுமையும் தேவை",
        "source": "சமகால தமிழ்",
        "category": "வாழ்க்கை"
    },
    {
        "id": 14,
        "word": "வாழ்க்கை",
        "text": "மனித வாழ்க்கையில் அனுபவங்கள் முக்கியமான பாடங்களை கற்றுத் தருகின்றன",
