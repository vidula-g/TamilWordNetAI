    },
    {
        "id": 4,
        "word": "அன்பு",
        "text": "அன்புடன் பிறரை அணுகுவது நல்ல மனித பண்பாகும்",
        "source": "சமகால தமிழ்",
        "category": "மனிதநேயம்"
    },
    {
        "id": 5,
        "word": "அன்பு",
        "text": "அன்பு கொண்ட உள்ளம் பிறருக்கு உதவ முனையும்",
        "source": "சமகால தமிழ்",
        "category": "மனிதநேயம்"
    },
    {
        "id": 6,
        "word": "தமிழ்",
        "text": "தமிழ்மொழி தொன்மையும் சிறப்பும் கொண்ட மொழியாகும்",
        "source": "தமிழ் இலக்கியம்",
        "category": "மொழி"
    },
    {
        "id": 7,
        "word": "தமிழ்",
        "text": "தமிழ் இலக்கியம் பல நூற்றாண்டுகளாக வளர்ந்து வந்துள்ளது",
        "source": "தமிழ் இலக்கியம்",
        "category": "இலக்கியம்"
    },
    {
        "id": 8,
        "word": "தமிழ்",
        "text": "தமிழ் மொழி உலகம் முழுவதும் பேசப்படும் பழமையான மொழிகளில் ஒன்றாகும்",
        "source": "தமிழ் இலக்கியம்",
        "category": "மொழி"
    },
    {
        "id": 9,
        "word": "அறம்",
        "text": "அறம் மனித வாழ்க்கைக்கு வழிகாட்டும் உயர்ந்த பண்பாகும்",
        "source": "திருக்குறள்",
        "category": "அறம்"
    },
    {
        "id": 10,
        "word": "அறம்",
        "text": "அறத்தை கடைப்பிடிப்பது மனிதனின் கடமையாகும்",
        "source": "தமிழ் இலக்கியம்",
        "category": "அறம்"
    },
    {
        "id": 11,
        "word": "நட்பு",
        "text": "நல்ல நட்பு வாழ்க்கையில் மகிழ்ச்சியையும் ஆதரவையும் அளிக்கிறது",
